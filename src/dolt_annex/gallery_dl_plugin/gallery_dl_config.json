{
    "extractor": {
		"archive": "./skip.sqlite3",
		"archive-table": "skip",
		"archive-format": "{_skip}",
        "archive-event": [],
		"path-metadata": "_path_metadata",
		"base-directory": "./gallery-dl-temp",
		"directory": [],
		"filename": "{category}-{subcategory}-{_id}-{_date}-{_page_number}.{extension}",
		"postprocessors": [
			{
				"name": "python",
				"event": "post",
				"function": "dolt_annex:gallery_dl_post"
			},
			{
				"name": "python",
				"event": "prepare",
				"function": "dolt_annex:gallery_dl_prepare"
			},
			{
				"name": "hash",
				"hashes": "md5,sha1,sha256",
				"event": "file"
			},
			{
				"name": "python",
				"event": "after",
				"function": "dolt_annex:gallery_dl_after"
			}
		],
        "itaku": {
            "image-unique": true,
            "include": "all"
        },
		"ao3": {
			"formats": ["html"]
		}
    }
}